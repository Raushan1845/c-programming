// WAP to count number of positive elements in an array

#include <stdio.h>

int main()
{
    int n;
    scanf("%d", &n);

    int arr[n];

    for(int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    int count = 0;

    for(int i = 0; i < n; i++) {
        if(arr[i] >= 0) {
            count++;
        }
    }

    printf("The number of positive elements is: %d", count);

    return 0;
}
